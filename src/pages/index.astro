---
import '../styles/brasero.css';

const preguntas = [
  { id: 'tiempo', texto: '¿Cómo calificarías el tiempo de preparación de tus platillos?', tipo: 'estrellas' },
  { id: 'presentacion', texto: '¿Qué te pareció la presentación de los platillos?', tipo: 'estrellas' },
  { id: 'mesero', texto: '¿Cómo fue la atención de tu mesero?', tipo: 'estrellas' },
  { id: 'sabor', texto: '¿Cómo calificarías el sabor de los platillos?', tipo: 'estrellas' },
  { id: 'mejorar', texto: '¿Qué podemos mejorar?', tipo: 'texto' },
];

const totalEstrellas = preguntas.filter((p) => p.tipo === 'estrellas').length;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/icon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>El Brasero | Encuesta de satisfacción</title>
  </head>
  <body>
    <div class="progreso" aria-hidden="true">
      <div class="progreso-barra" id="barra"></div>
    </div>

    <main>
      <header class="hero">
        <!-- Acceso escondido: al dar clic al logo se abre el login del administrador -->
        <a href="/admin/login" class="logo-link">
          <img src="/brasero.webp" alt="El Brasero" class="logo logo-mezcla" />
        </a>
        <p class="eyebrow">Encuesta de satisfacción</p>
        <h1>¿Cómo estuvo tu <span>experiencia</span>?</h1>
        <p class="subtitulo">Son solo 5 preguntas. Tu opinión nos ayuda a mejorar cada platillo.</p>
        <p class="contador" id="contador">
          <strong id="respondidas">0</strong> de {totalEstrellas} calificadas
        </p>
      </header>

      <form id="encuesta" novalidate>
        {preguntas.map((p, i) => (
          <fieldset class="pregunta" data-tipo={p.tipo} style={`--i: ${i}`}>
            <legend>
              <span class="numero">{String(i + 1).padStart(2, '0')}</span>
              <span>{p.texto}</span>
            </legend>

            {p.tipo === 'estrellas' && (
              <>
                <div class="calificacion">
                  <div class="estrellas">
                    {[5, 4, 3, 2, 1].map((n) => (
                      <>
                        <input class="sr-only" type="radio" id={`${p.id}-${n}`} name={p.id} value={n} />
                        <label for={`${p.id}-${n}`} title={`${n} de 5`}>
                          <span class="sr-only">{n} de 5</span>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
                          </svg>
                        </label>
                      </>
                    ))}
                  </div>
                  <span class="calificacion-texto" data-texto>Toca una estrella</span>
                </div>
                <p class="aviso-falta">Esta pregunta es obligatoria</p>
              </>
            )}

            {p.tipo === 'texto' && (
              <>
                <textarea
                  class="campo"
                  name={p.id}
                  id="comentario"
                  rows="4"
                  maxlength="1000"
                  placeholder="Cuéntanos qué te gustaría que mejoráramos (opcional)"
                ></textarea>
                <p class="conteo"><span id="conteo">0</span>/1000</p>
              </>
            )}
          </fieldset>
        ))}

        <p id="error" class="alerta" role="alert" hidden>
          No se pudo enviar tu encuesta. Revisa tu conexión e intenta de nuevo.
        </p>

        <button type="submit" id="boton" class="btn-primario">
          <span id="boton-texto">Enviar encuesta</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>

      <section id="gracias" hidden>
        <div class="check">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
        </div>
        <h2>¡Gracias por tu opinión!</h2>
        <p>Nos ayuda muchísimo. Te esperamos pronto en El Brasero.</p>
      </section>
    </main>

    <script>
      const form = document.getElementById('encuesta') as HTMLFormElement;
      const gracias = document.getElementById('gracias') as HTMLElement;
      const error = document.getElementById('error') as HTMLElement;
      const boton = document.getElementById('boton') as HTMLButtonElement;
      const botonTexto = document.getElementById('boton-texto') as HTMLElement;
      const barra = document.getElementById('barra') as HTMLElement;
      const respondidas = document.getElementById('respondidas') as HTMLElement;
      const contador = document.getElementById('contador') as HTMLElement;
      const comentario = document.getElementById('comentario') as HTMLTextAreaElement;
      const conteo = document.getElementById('conteo') as HTMLElement;

      const textos = ['', 'Malo', 'Regular', 'Bueno', 'Muy bueno', 'Excelente'];
      const grupos = Array.from(form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-tipo="estrellas"]'));

      function actualizarProgreso() {
        const hechas = grupos.filter((g) => g.querySelector('input:checked')).length;
        respondidas.textContent = String(hechas);
        barra.style.width = `${(hechas / grupos.length) * 100}%`;
      }

      // Cuando el cliente elige una estrella
      grupos.forEach((grupo) => {
        grupo.addEventListener('change', (e) => {
          const input = e.target as HTMLInputElement;
          const texto = grupo.querySelector('[data-texto]') as HTMLElement;
          texto.textContent = textos[Number(input.value)];
          grupo.classList.add('respondida');
          grupo.classList.remove('falta');
          actualizarProgreso();
        });
      });

      // Contador de letras del comentario
      comentario.addEventListener('input', () => {
        conteo.textContent = String(comentario.value.length);
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        error.hidden = true;

        // Revisamos que las 4 preguntas de estrellas estén contestadas
        const faltantes = grupos.filter((g) => !g.querySelector('input:checked'));
        if (faltantes.length > 0) {
          faltantes.forEach((g) => g.classList.add('falta'));
          faltantes[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        boton.disabled = true;
        botonTexto.textContent = 'Enviando...';

        try {
          const respuestas = Object.fromEntries(new FormData(form));
          const res = await fetch('/api/encuesta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(respuestas),
          });
          if (!res.ok) throw new Error('Error al guardar');

          form.hidden = true;
          contador.hidden = true;
          gracias.hidden = false;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch {
          error.hidden = false;
          boton.disabled = false;
          botonTexto.textContent = 'Enviar encuesta';
        }
      });
    </script>

    <style is:global>
      /* Barra de progreso de arriba */
      .progreso {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: rgba(255, 255, 255, 0.06);
        z-index: 10;
      }
      .progreso-barra {
        width: 0;
        height: 100%;
        background: linear-gradient(90deg, var(--rojo), var(--brasa));
        box-shadow: 0 0 12px rgba(225, 29, 29, 0.6);
        transition: width 0.4s ease;
      }

      main {
        max-width: 640px;
        margin: 0 auto;
        padding: 40px 16px 64px;
      }

      /* Encabezado */
      .hero {
        text-align: center;
        margin-bottom: 32px;
        animation: aparecer 0.6s ease both;
      }
      .logo-link {
        display: inline-block;
        cursor: default;
      }
      .logo {
        width: 190px;
        height: auto;
        display: block;
        margin: 0 auto 4px;
      }
      .hero h1 {
        margin: 0 0 12px;
        font-family: var(--titulos);
        font-weight: 400;
        font-size: clamp(42px, 10vw, 64px);
        line-height: 0.95;
        letter-spacing: 0.02em;
      }
      .hero h1 span { color: var(--rojo); }
      .subtitulo {
        max-width: 420px;
        margin: 0 auto 18px;
        color: var(--texto-suave);
        line-height: 1.5;
      }
      .contador {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        padding: 6px 14px;
        font-size: 13px;
        color: var(--texto-suave);
        background: var(--superficie);
        border: 1px solid var(--borde);
        border-radius: 999px;
      }
      .contador strong { color: var(--texto); }
      .contador::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--rojo);
        box-shadow: 0 0 8px var(--rojo);
      }

      /* Tarjeta de cada pregunta */
      .pregunta {
        position: relative;
        min-width: 0;
        margin: 0 0 16px;
        padding: 24px;
        background: linear-gradient(180deg, var(--superficie-2), var(--superficie));
        border: 1px solid var(--borde);
        border-radius: var(--radio);
        animation: aparecer 0.5s ease both;
        animation-delay: calc(var(--i) * 80ms + 150ms);
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .pregunta.respondida { border-color: rgba(225, 29, 29, 0.45); }
      .pregunta.falta {
        border-color: var(--rojo);
        box-shadow: 0 0 0 3px rgba(225, 29, 29, 0.2);
      }
      .pregunta legend {
        float: left;
        width: 100%;
        padding: 0;
        margin-bottom: 18px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
        font-size: 17px;
        font-weight: 600;
        line-height: 1.4;
      }
      .numero {
        min-width: 32px;
        font-family: var(--titulos);
        font-size: 30px;
        font-weight: 400;
        line-height: 1;
        color: var(--rojo);
      }

      /* ===== Estrellas ===== */
      .calificacion {
        clear: both;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }
      .estrellas {
        display: flex;
        flex-direction: row-reverse;
        gap: 8px;
      }
      .estrellas label {
        display: flex;
        padding: 2px;
        cursor: pointer;
        transition: transform 0.15s;
      }

      /* Estrella vacía: solo el contorno */
      .estrellas svg {
        width: 40px;
        height: 40px;
        overflow: visible;
        fill: rgba(255, 255, 255, 0.03);
        stroke: #6b6b6b;
        stroke-width: 1.6;
        stroke-linejoin: round;
        transition: fill 0.15s, stroke 0.15s, filter 0.15s;
      }

      /* Al pasar el mouse (vista previa) */
      .estrellas label:hover svg,
      .estrellas label:hover ~ label svg {
        fill: rgba(255, 183, 3, 0.35);
        stroke: var(--oro);
      }

      /* Estrellas seleccionadas: rellenas de dorado */
      .estrellas input:checked ~ label svg {
        fill: var(--oro);
        stroke: #ffd166;
      }
      .estrellas input:checked + label svg {
        filter: drop-shadow(0 0 8px rgba(255, 183, 3, 0.6));
      }

      .estrellas label:hover { transform: scale(1.15); }
      .estrellas label:active { transform: scale(0.95); }
      .estrellas input:focus-visible + label {
        outline: 2px solid var(--rojo);
        outline-offset: 4px;
        border-radius: 8px;
      }

      /* Si falta contestar, el contorno se pone rojo */
      .falta .estrellas svg { stroke: #ff6b6b; }

      .calificacion-texto {
        font-size: 14px;
        color: var(--texto-suave);
      }
      .respondida .calificacion-texto {
        color: var(--oro);
        font-weight: 600;
      }
      .aviso-falta {
        display: none;
        margin: 12px 0 0;
        font-size: 13px;
        color: #ff6b6b;
      }
      .falta .aviso-falta { display: block; }

      /* Comentario */
      .pregunta textarea {
        clear: both;
        min-height: 110px;
        resize: vertical;
      }
      .conteo {
        margin: 6px 0 0;
        text-align: right;
        font-size: 12px;
        color: var(--texto-suave);
      }

      #encuesta .btn-primario {
        margin-top: 8px;
        animation: aparecer 0.5s ease both;
        animation-delay: 0.6s;
      }

      /* Mensaje de gracias */
      #gracias {
        text-align: center;
        padding: 16px 0;
        animation: aparecer 0.5s ease both;
      }
      .check {
        width: 88px;
        height: 88px;
        margin: 0 auto 20px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: rgba(225, 29, 29, 0.12);
        border: 2px solid var(--rojo);
        box-shadow: 0 0 32px rgba(225, 29, 29, 0.35);
      }
      .check svg {
        width: 40px;
        height: 40px;
        fill: none;
        stroke: var(--texto);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 30;
        stroke-dashoffset: 30;
        animation: trazo 0.5s 0.3s ease forwards;
      }
      #gracias h2 {
        margin: 0 0 8px;
        font-family: var(--titulos);
        font-weight: 400;
        font-size: 48px;
        letter-spacing: 0.02em;
      }
      #gracias p {
        margin: 0;
        color: var(--texto-suave);
      }
      @keyframes trazo { to { stroke-dashoffset: 0; } }
    </style>
  </body>
</html>