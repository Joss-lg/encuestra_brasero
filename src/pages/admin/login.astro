---
import '../../styles/brasero.css';

export const prerender = false;

let error = '';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const password = String(datos.get('password') ?? '');

  if (import.meta.env.ADMIN_PASSWORD && password === import.meta.env.ADMIN_PASSWORD) {
    Astro.cookies.set('admin_sesion', import.meta.env.ADMIN_TOKEN, {
      path: '/',
      httpOnly: true,
      sameSite: 'strict',
      maxAge: 60 * 60 * 8, // 8 horas
    });
    return Astro.redirect('/admin');
  }

  error = 'Contraseña incorrecta. Intenta de nuevo.';
}

// Chispas de brasa animadas (posición, retraso y duración de cada una)
const brasas = Array.from({ length: 16 }, (_, i) => ({
  x: (i * 37 + 5) % 100,
  retraso: ((i * 0.9) % 7).toFixed(1),
  duracion: 5 + (i % 5),
}));
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/icon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>El Brasero | Acceso administrador</title>
  </head>
  <body>
    <main class="login">
      <!-- Lado izquierdo: marca -->
      <section class="marca-panel">
        <div class="brasas" aria-hidden="true">
          {brasas.map((b) => (
            <span style={`--x: ${b.x}%; --retraso: ${b.retraso}s; --duracion: ${b.duracion}s`}></span>
          ))}
        </div>

        <div class="marca-contenido">
          <a href="/" class="logo-link">
            <img src="/brasero.webp" alt="El Brasero" class="logo logo-mezcla" />
          </a>
          <h2>Lo que opinan<br />tus <span>clientes</span></h2>
          <ul class="beneficios">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
              Promedios de cada pregunta
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg>
              Gráficas de calificaciones
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.8 7L3 21l2-6.2A8 8 0 1 1 21 12z" /></svg>
              Todos los comentarios
            </li>
          </ul>
        </div>
      </section>

      <!-- Lado derecho: formulario -->
      <section class="form-panel">
        <div class="tarjeta">
          <div class="candado">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="5" y="11" width="14" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
          </div>

          <p class="eyebrow">Acceso restringido</p>
          <h1>Bienvenido</h1>
          <p class="instrucciones">Ingresa la contraseña para ver los resultados de la encuesta.</p>

          <form method="POST" id="form-login">
            <label for="password">Contraseña</label>
            <div class="campo-con-icono">
              <svg class="icono-campo" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="5" y="11" width="14" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              <input
                class:list={['campo', { 'campo-error': error }]}
                type="password"
                id="password"
                name="password"
                placeholder="Escribe tu contraseña"
                autocomplete="current-password"
                required
                autofocus
              />
              <!-- Botón del ojito: la clase "mostrando" decide qué ojo se ve -->
              <button type="button" class="ver" id="ver" aria-label="Mostrar contraseña">
                <svg class="ojo-abierto" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg class="ojo-cerrado" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 3l18 18M10.6 5.1A10.6 10.6 0 0 1 12 5c6.5 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.2M6.6 6.6C3.8 8.4 2 12 2 12s3.5 7 10 7a9.8 9.8 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                </svg>
              </button>
            </div>

            <p class="aviso-mayus" id="mayus" hidden>⚠ Bloq Mayús está activado</p>

            {error && <p class="alerta sacudir" role="alert">{error}</p>}

            <button type="submit" class="btn-primario" id="entrar">
              <span id="entrar-texto">Entrar al panel</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
          </form>

          <a href="/" class="volver">← Volver a la encuesta</a>
        </div>
      </section>
    </main>

    <script>
      const input = document.getElementById('password') as HTMLInputElement;
      const ver = document.getElementById('ver') as HTMLButtonElement;
      const mayus = document.getElementById('mayus') as HTMLElement;
      const form = document.getElementById('form-login') as HTMLFormElement;
      const entrar = document.getElementById('entrar') as HTMLButtonElement;
      const entrarTexto = document.getElementById('entrar-texto') as HTMLElement;

      // Mostrar u ocultar la contraseña
      ver.addEventListener('click', () => {
        const oculta = input.type === 'password';
        input.type = oculta ? 'text' : 'password';
        ver.classList.toggle('mostrando', oculta);
        ver.setAttribute('aria-label', oculta ? 'Ocultar contraseña' : 'Mostrar contraseña');
        input.focus();
      });

      // Aviso de Bloq Mayús
      const revisarMayus = (e: KeyboardEvent) => {
        mayus.hidden = !e.getModifierState('CapsLock');
      };
      input.addEventListener('keydown', revisarMayus);
      input.addEventListener('keyup', revisarMayus);

      // Quitar el rojo del campo cuando vuelve a escribir
      input.addEventListener('input', () => input.classList.remove('campo-error'));

      // Botón en modo "cargando"
      form.addEventListener('submit', () => {
        entrar.disabled = true;
        entrarTexto.textContent = 'Entrando...';
      });
    </script>

    <style is:global>
      .login {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr;
      }

      /* ===== Lado de la marca ===== */
      .marca-panel {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 24px 8px;
      }
      .marca-contenido {
        position: relative;
        z-index: 1;
        text-align: center;
        animation: aparecer 0.6s ease both;
      }
      .logo-link { display: inline-block; }
      .logo {
        width: 150px;
        height: auto;
        display: block;
        margin: 0 auto;
      }
      .marca-panel h2 {
        margin: 8px 0 28px;
        font-family: var(--titulos);
        font-weight: 400;
        font-size: 64px;
        line-height: 0.95;
        letter-spacing: 0.02em;
      }
      .marca-panel h2 span { color: var(--rojo); }
      .beneficios {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 12px;
        text-align: left;
      }
      .beneficios li {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--texto-suave);
      }
      .beneficios svg {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        padding: 8px;
        fill: none;
        stroke: var(--rojo);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        background: rgba(225, 29, 29, 0.1);
        border: 1px solid rgba(225, 29, 29, 0.3);
        border-radius: 10px;
      }

      /* Chispas que suben */
      .brasas {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .brasas span {
        position: absolute;
        bottom: -10px;
        left: var(--x);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--brasa);
        box-shadow: 0 0 8px 2px rgba(255, 106, 26, 0.7);
        opacity: 0;
        animation: subir var(--duracion) linear var(--retraso) infinite;
      }
      @keyframes subir {
        0% { transform: translate(0, 0) scale(1); opacity: 0; }
        10% { opacity: 1; }
        100% { transform: translate(24px, -80vh) scale(0.3); opacity: 0; }
      }

      /* En celular: solo el logo arriba */
      @media (max-width: 899px) {
        .marca-panel h2,
        .beneficios,
        .brasas { display: none; }
      }

      /* En computadora: dos columnas */
      @media (min-width: 900px) {
        .login { grid-template-columns: 1.1fr 1fr; }
        .marca-panel {
          padding: 48px;
          border-right: 1px solid var(--borde);
          background:
            radial-gradient(ellipse 90% 60% at 50% 115%, rgba(225, 29, 29, 0.35), transparent 65%),
            linear-gradient(180deg, #0a0a0a, #000000);
        }
        .marca-contenido { text-align: left; }
        .logo {
          width: 170px;
          margin: 0 0 8px -12px;
        }
      }

      /* ===== Lado del formulario ===== */
      .form-panel {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px 48px;
      }
      .tarjeta {
        width: 100%;
        max-width: 400px;
        padding: 32px 28px;
        background: linear-gradient(180deg, var(--superficie-2), var(--superficie));
        border: 1px solid var(--borde);
        border-radius: 20px;
        box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
        animation: aparecer 0.6s ease both;
        animation-delay: 0.15s;
      }
      .candado {
        width: 56px;
        height: 56px;
        margin-bottom: 20px;
        display: grid;
        place-items: center;
        background: rgba(225, 29, 29, 0.12);
        border: 1px solid rgba(225, 29, 29, 0.4);
        border-radius: 16px;
        box-shadow: 0 0 24px rgba(225, 29, 29, 0.25);
      }
      .candado svg {
        width: 26px;
        height: 26px;
        fill: none;
        stroke: var(--rojo);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .tarjeta h1 {
        margin: 0 0 6px;
        font-family: var(--titulos);
        font-weight: 400;
        font-size: 48px;
        line-height: 1;
        letter-spacing: 0.02em;
      }
      .instrucciones {
        margin: 0 0 24px;
        font-size: 14px;
        line-height: 1.5;
        color: var(--texto-suave);
      }
      .tarjeta label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
      }

      /* Campo con candado y ojito */
      .campo-con-icono {
        position: relative;
        margin-bottom: 16px;
      }
      .campo-con-icono .campo {
        padding-left: 44px;
        padding-right: 50px;
      }
      .campo-error {
        border-color: var(--rojo) !important;
        box-shadow: 0 0 0 3px rgba(225, 29, 29, 0.2);
      }
      .icono-campo {
        position: absolute;
        top: 50%;
        left: 14px;
        width: 18px;
        height: 18px;
        transform: translateY(-50%);
        fill: none;
        stroke: var(--texto-suave);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
      }
      .ver {
        position: absolute;
        top: 50%;
        right: 6px;
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        transform: translateY(-50%);
        background: none;
        border: none;
        border-radius: 10px;
        color: var(--texto-suave);
        cursor: pointer;
        transition: color 0.15s, background 0.15s;
      }
      .ver:hover { color: var(--texto); background: rgba(255, 255, 255, 0.06); }
      .ver:focus-visible { outline: 2px solid var(--rojo); }
      .ver svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* Qué ojo se ve: normal = ojo abierto, con "mostrando" = ojo cerrado */
      .ver .ojo-cerrado { display: none; }
      .ver.mostrando .ojo-abierto { display: none; }
      .ver.mostrando .ojo-cerrado { display: block; }

      .aviso-mayus {
        margin: -6px 0 14px;
        font-size: 13px;
        color: var(--oro);
      }

      /* Mensaje de error que tiembla */
      .sacudir { animation: sacudir 0.4s ease; }
      @keyframes sacudir {
        0%, 100% { transform: none; }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
      }

      .volver {
        display: block;
        margin-top: 20px;
        text-align: center;
        font-size: 14px;
        color: var(--texto-suave);
        text-decoration: none;
      }
      .volver:hover { color: var(--texto); }
    </style>
  </body>
</html>